+def validate_eip8321(network_params):
+    epoch = network_params["eip8321_fork_epoch"]
+    version = network_params["eip8321_fork_version"]
+    if type(epoch) != "int" or epoch < 0 or epoch > constants.FAR_FUTURE_EPOCH:
+        fail("eip8321_fork_epoch must be a non-negative uint64")
+    if type(version) != "string" or len(version) != 10 or not version.startswith("0x"):
+        fail("eip8321_fork_version must be a four-byte hex value")
+    for i in range(2, 10):
+        if version[i] not in "0123456789abcdefABCDEF":
+            fail("eip8321_fork_version must be a four-byte hex value")
+    if epoch != constants.FAR_FUTURE_EPOCH:
+        if epoch == 0 or network_params["heze_fork_epoch"] >= epoch:
